{
    "plugins": ["prettier-plugin-tailwindcss"],
    "printWidth": 100,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "singleAttributePerLine": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "css"
}
